rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Beats are publicly readable, only producers can write their own
    match /beats/{beatId} {
      allow read: if true;
      allow write: if request.auth != null && resource == null || request.auth.uid == resource.data.producerId;
      allow create: if request.auth != null;
    }
    // Orders: buyers can read their own, create new ones
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.buyerId;
      allow create: if request.auth != null;
    }
    // Reviews: publicly readable, auth users can create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
  }
}